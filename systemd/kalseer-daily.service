# Template — copy to ~/.config/systemd/user/ and replace /path/to/kalseer
# (and add Environment= lines for KALSEER_* config as needed).
[Unit]
Description=Kalseer morning brief pipeline (paper trading)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/path/to/kalseer
ExecStart=/path/to/kalseer/bin/daily.sh
# Ensure the claude CLI and docker are on PATH for the user service:
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Example config:
# Environment=KALSEER_DATA_DIR=%h/kalseer-data
# Environment=KALSEER_PORT=8085
# Push alert on pipeline failure (any URL that accepts a plain-text POST,
# e.g. a private ntfy topic). Strongly recommended: a silent claude-auth
# expiry once cost 12 straight briefs before anyone noticed.
# Environment=KALSEER_ALERT_URL=https://ntfy.sh/your-secret-topic
# Dead-man's switch: pinged after every green run. The alert above can't fire
# when the host is down and no run starts (gap #4, Oct 2026); an external
# check expecting a daily ping (e.g. healthchecks.io, period 1 day, grace a
# few hours) pages on the missing ping instead.
# Environment=KALSEER_HEARTBEAT_URL=https://hc-ping.com/your-check-uuid
TimeoutStartSec=45min
